#!/usr/bin/env python3

# Summarizes a FUT_PERF_LOG CSV produced by the real client
# (src/client/perf.rs). Usage:
#
#   FUT_PERF_LOG=/tmp/fut-frames.csv fut attach ...   # exercise the UI
#   scripts/perf/report /tmp/fut-frames.csv

import csv
import math
import sys
from collections import defaultdict


def percentile(values, fraction):
    return values[max(math.ceil(len(values) * fraction) - 1, 0)]


if len(sys.argv) != 2:
    raise SystemExit("Usage: scripts/perf/report FRAME_LOG.csv")

path = sys.argv[1]
events = defaultdict(list)
byte_counts = defaultdict(int)
timestamps = []

with open(path, newline="") as rows:
    next(rows, None)
    for row in csv.reader(rows):
        if len(row) < 3:
            continue
        timestamp, event, duration = row[:3]
        size = row[3] if len(row) > 3 else "0"
        events[event].append(int(duration))
        byte_counts[event] += int(size)
        timestamps.append(int(timestamp))

if not timestamps:
    raise SystemExit(f"No events in {path}")

wall_s = (timestamps[-1] - timestamps[0]) / 1_000_000
print(f"window: {wall_s:.1f} s")

for event, durations in sorted(events.items()):
    ordered = sorted(durations)
    total_ms = sum(durations) / 1000
    row = (
        f"{event:<8} n={len(durations):<6d} rate={len(durations) / wall_s:6.1f}/s  "
        f"avg={sum(durations) / len(durations):6.0f}us  "
        f"p95={percentile(ordered, 0.95):6.0f}us  max={ordered[-1]:6.0f}us  "
        f"busy={100 * total_ms / (wall_s * 1000):4.1f}%"
    )
    if byte_counts[event] > 0:
        row += f"  wire={byte_counts[event] / 1024 / 1024:.1f}MiB"
    print(row)
