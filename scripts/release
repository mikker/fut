#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

die() {
  echo "release: $*" >&2
  exit 1
}

command -v gh >/dev/null || die "GitHub CLI (gh) is required to monitor the release"
gh auth status >/dev/null 2>&1 || die "GitHub CLI is not authenticated"

[[ "$(git branch --show-current)" == "main" ]] || die "run this from main"
[[ -z "$(git status --porcelain)" ]] || die "working tree is not clean"

git fetch origin main --tags
read -r behind ahead < <(git rev-list --left-right --count origin/main...main)
[[ "$behind" == "0" ]] || die "main is behind or has diverged from origin/main"
if [[ "$ahead" != "0" ]]; then
  echo "Pushing $ahead unreleased main commit(s)"
  git push origin main || die "could not synchronize main with origin/main"
fi

latest="$(git ls-remote --tags --refs origin \
  | awk '{ sub("refs/tags/", "", $2); if ($2 ~ /^0\.[1-9][0-9]*$/) print $2 }' \
  | sort -t. -k2,2n \
  | tail -1)"
if [[ -z "$latest" ]]; then
  version="0.1"
else
  version="0.$((10#${latest#0.} + 1))"
fi

package_version="$version.0"
current_package_version="$(awk -F '"' '/^version = "/ { print $2; exit }' Cargo.toml)"

if [[ "$current_package_version" != "$package_version" ]]; then
  perl -0pi -e "s/\A(\[package\].*?^version = \x22)[^\x22]+/\${1}$package_version/ms" Cargo.toml
  cargo check --quiet
fi

perl -0pi -e "s/^version: \x22[^\x22]+\x22/version: \x22$version\x22/m" docs/_config.yml

echo "Releasing $version"
cargo fmt --check
cargo clippy --all-targets --all-features -- -D warnings
RUST_TEST_THREADS=1 cargo test --all-targets --all-features

if ! git diff --quiet -- Cargo.toml Cargo.lock docs/_config.yml; then
  git add Cargo.toml Cargo.lock docs/_config.yml
  git commit -m "Release $version"
fi

[[ "$(awk -F '"' '/^version = "/ { print $2; exit }' Cargo.toml)" == "$package_version" ]] || die "Cargo package version does not match $version"
if git rev-parse --verify "refs/tags/$version" >/dev/null 2>&1; then
  git tag -d "$version"
fi
git tag -a "$version" -m "Release $version"
if ! git push --atomic origin main "$version"; then
  git tag -d "$version"
  die "push failed; no remote release was created"
fi

release_sha="$(git rev-parse HEAD)"
run_id=""
for _ in {1..30}; do
  run_id="$(gh run list \
    --repo mikker/fut \
    --workflow release.yml \
    --branch "$version" \
    --event push \
    --limit 5 \
    --json databaseId,headSha \
    --jq "map(select(.headSha == \"$release_sha\"))[0].databaseId // empty")"
  [[ -z "$run_id" ]] || break
  sleep 2
done
[[ -n "$run_id" ]] || die "GitHub Actions did not start for $version"

run_url="https://github.com/mikker/fut/actions/runs/$run_id"
echo "Release $version is running at $run_url"
gh run watch "$run_id" --repo mikker/fut --exit-status || die "release workflow failed: $run_url"
echo "Released $version and updated mikker/homebrew-tap"
